# ============================================================

# AI Workflow Orchestration Platform

# Example Environment Configuration

# ============================================================

# ==========================

# App

# ==========================

APP_NAME=AI Workflow Orchestration Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ============================================================

# LLM PROVIDER

# ============================================================

LLM_PROVIDER=openrouter

# ============================================================

# OPENROUTER

# ============================================================

OPENROUTER_API_KEY=sk-or-v1-example-not-a-real-key-000000000000000000
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Research Assistant
OPENROUTER_TIMEOUT=120

# ============================================================

# GENERATION

# ============================================================

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TOP_P=1.0
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0
LLM_MAX_RETRIES=3
LLM_STREAM=true
LLM_VERIFY_SSL=true

# ==========================

# Security

# ==========================

SECRET_KEY=example-only-secret-key-do-not-use-in-production
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================

# Database

# ==========================

DATABASE_URL=postgresql+psycopg://postgres:example_password@localhost:5432/enterprise_ai

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ==========================

# API

# ==========================

API_V1_PREFIX=/api/v1

# ==========================

# Frontend / Backend URLs

# ==========================

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ==========================

# CORS

# ==========================

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ==========================

# Redis

# ==========================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==========================

# S3 / MinIO

# ==========================

S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=example-access-key
S3_SECRET_ACCESS_KEY=example-secret-key

# ==========================

# Document Processing

# ==========================

MAX_FILE_SIZE_MB=100

# ==========================

# Chunking

# ==========================

CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ==========================

# Embeddings

# ==========================

EMBEDDING_PROVIDER=local

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

EMBEDDING_DEVICE=cpu

EMBEDDING_DIMENSION=384

EMBEDDING_BATCH_SIZE=32

# ==========================

# Cohere

# ==========================

COHERE_API_KEY=cohere-example-not-a-real-key-000000000000
COHERE_EMBEDDING_MODEL=embed-v4.0
COHERE_EMBEDDING_INPUT_TYPE=search_document
COHERE_EMBEDDING_BATCH_SIZE=96

# ==========================

# OCR

# ==========================

OCR_PROVIDER=tesseract

# ==========================

# Retrieval

# ==========================

RETRIEVAL_TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=0.0

# ==========================

# Logging

# ==========================

LOG_LEVEL=INFO
LOG_JSON=false

# ==========================

# Object Storage

# ==========================

STORAGE_BACKEND=minio
STORAGE_BUCKET=documents
STORAGE_BASE_PATH=./storage

# ==========================

# MinIO

# ==========================

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=example-minio-access-key
MINIO_SECRET_KEY=example-minio-secret-key
MINIO_REGION=us-east-1
MINIO_SECURE=false
